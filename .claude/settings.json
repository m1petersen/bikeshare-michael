{
  "model": "bikeshare-coder",
  "env": {
    "ANTHROPIC_BASE_URL": "http://localhost:11434",
    "ANTHROPIC_AUTH_TOKEN": "ollama",
    "ANTHROPIC_API_KEY": "",
    "CLAUDE_CODE_DISABLE_NONESSENTIAL_TRAFFIC": "1"
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "${CLAUDE_PROJECT_DIR}/.claude/hooks/protect_raw.sh",
            "timeout": 10,
            "statusMessage": "Checking for writes to data/raw..."
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "${CLAUDE_PROJECT_DIR}/.claude/hooks/check_leakage.sh",
            "timeout": 60,
            "statusMessage": "Re-running the test suite..."
          }
        ]
      }
    ]
  },
  "permissions": {
    "allow": [
      "Bash(make:*)",
      "Bash(python -m pytest:*)",
      "Bash(python -m src.:*)",
      "Bash(git diff:*)",
      "Bash(git status)"
    ],
    "deny": [
      "Write(./data/raw/**)",
      "Edit(./data/raw/**)",
      "Bash(cp * data/raw/*)",
      "Bash(mv * data/raw/*)",
      "Bash(rm -rf:*)"
    ]
  }
}
